/* Plurality ACCEPT fixture (shield-plurality-brief.md Sec 4): one of two
 * shields declared by the SAME shields: list, in a folder named neither
 * of them (plural_pair/). Never a real corpus shield.
 */

#include <dt-bindings/connector/fixture-nexus.h>

/ {
	shield-templates {
		fx_alpha: fx_alpha {
			fxa_plug: plug {
				compatible = "shield,plug";
				shield,plugs = "fixture-nexus";
			};

			gpio {
				fxa_led: led {
					gpios = <&fxa_plug FIXTURE_D0 0>;
				};
			};
		};
	};
};
