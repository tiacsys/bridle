/* Fixture consumer, THROUGH-CARRIER witness (test_three_cell_pwm.py:
 * 3-cell nexus and nonzero flags through a carrier): identical
 * shape to tc_servo_plain (three-cell-pwm-plain's own shield), mated
 * against the carrier's exposed socket instead of the board socket
 * directly -- proving the synthesized nexus (_channel_nexus_block,
 * cell-count-general for every function) carries a nonzero flags cell exactly
 * like a real board socket does.
 */

/ {
	shield-templates {
		tc_pwm_consumer: tc_pwm_consumer {
			plug: plug {
				compatible = "shield,plug";
				shield,plugs = "three-cell-pwm-nexus";
			};

			pwm {
				led: led {
					compatible = "vnd,pwm-servo";
					pwms = <&plug 0 20000000 1>;
				};
			};
		};
	};
};
