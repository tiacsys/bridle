/* Fixture-only shield: declares a revisions: axis (rig-variants-
 * revisions.md V1c) but ships NO rev_fixture_2.shield/.conf fragment --
 * exercises the missing-non-default-fragment diagnostic (the shield-side
 * analogue of rule 10). Never a real corpus shield.
 */

/ {
	shield-templates {
		rev_fixture: rev_fixture {
			rf2_plug: plug {
				compatible = "shield,plug";
				shield,plugs = "i2c-port";

				i2c {
					rf2_sensor: sensor@60 {
						compatible = "vnd,temp0x48";
						reg = <0x60>;
					};
				};
			};
		};
	};
};
