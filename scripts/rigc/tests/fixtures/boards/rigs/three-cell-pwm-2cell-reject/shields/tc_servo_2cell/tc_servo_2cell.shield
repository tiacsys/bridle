/* Fixture consumer, 2-CELL REJECT witness (test_three_cell_pwm.py,
 * the reject half of the nonzero-flags pair): identical shape and
 * identical nonzero flags claim to tc_servo_plain (three-cell-pwm-plain
 * rig), mated against the board's 2-CELL PWM socket instead -- there is
 * genuinely no cell for flags there (lotus's own atmel,sam0-tcc-pwm
 * shape), so analyzer/gpio.py's _collect_channel must still refuse this,
 * naming the socket and its cell count, proving the pair alongside the
 * plain rig's accept case without needing a real Zephyr build.
 */

/ {
	shield-templates {
		tc_servo_2cell: tc_servo_2cell {
			tcs2_plug: plug {
				compatible = "shield,plug";
				shield,plugs = "three-cell-pwm-nexus";
			};

			pwm {
				servo: servo {
					compatible = "vnd,pwm-servo";
					pwms = <&tcs2_plug 0 20000000 1>;
				};
			};
		};
	};
};
