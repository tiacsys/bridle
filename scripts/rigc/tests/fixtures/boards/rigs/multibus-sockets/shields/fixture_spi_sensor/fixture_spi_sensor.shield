/* Fixture shield (multi-bus-socket feature): a device on the "spi-sensors"
 * named bus. CS is pool-allocated (no shield,cs-position) -- the
 * multi-bus-socket accept case draws it from socket,spi-sensors-cs-pool's
 * binding default.
 */

#include <dt-bindings/connector/fixture-multibus.h>

/ {
	shield-templates {
		fixture_spi_sensor: fixture_spi_sensor {
			fss_plug: plug {
				compatible = "shield,plug";
				shield,plugs = "fixture-multibus";

				spi-sensors {
					fss_sensor: sensor {
						compatible = "vnd,fixture-spi-sensor";
						spi-max-frequency = <1000000>;
					};
				};
			};
		};
	};
};
