/* Fixture consumer, PWM half (test_carrier_analog_passthrough.py):
 * mirrors grove_pwm_led's own shape -- the plug's implicit 3-cell PWM
 * claim is the generic Zephyr shield-side frame (position, period,
 * flags), independent of whatever cell count the socket it eventually
 * mates declares (rigc renders the ref at the mated socket's count).
 */

/ {
	shield-templates {
		fixture_analog_pwm_consumer: fixture_analog_pwm_consumer {
			plug: plug {
				compatible = "shield,plug";
				shield,plugs = "fixture-analog-nexus";
			};

			pwm {
				fapc_led: led {
					compatible = "vnd,pwm-servo";
					pwms = <&plug 0 20000000 0>;
				};
			};
		};
	};
};
