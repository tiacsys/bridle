rgb_led_pio: &rpipico_pio_leds {};

#include "led_matrix.dtsi"

#include <zephyr/dt-bindings/gpio/gpio.h>

&led_strip_matrix {
	status = "okay";
};

&led_strip {
	gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;		/* PIO0:OUT @ GP22 */
	status = "okay";
};

&rgb_led_pio_ws2812 {
	status = "okay";
	pinctrl-0 = <&pio0_ws2812_leds_sgprm_pes1>;
	pinctrl-names = "default";
};
