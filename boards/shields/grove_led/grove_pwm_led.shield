/* Shield: PWM LED, the other half of bridle's grove_led/ folder (32
 * grove_pwm_led_dN pwm-leds overlays, alongside the 32 gpio-leds overlays
 * grove_led.shield already ports). MCU drives the LED as a dimmable PWM
 * output on the Grove signal pin; bridle's own period is PWM_MSEC(20).
 *
 * The shield-side claim is (position, period, flags), 3 cells, the generic
 * count -- so the plug node declares none (plug-unification-brief.md Sec 5).
 * The SOCKET's own #pwm-cells is a board fact and differs (2 on every real
 * socket this shield mates -- position, period, no flags): that asymmetry is
 * the existing design (see grove_servo.shield), not a mistake to fix here.
 *
 * shield,collect = "pwm-leds" joins the shared pwm-leds collection node
 * (Conv. 9), the pwm-shaped sibling of grove_led's own gpio-leds entry --
 * one collection node per compatible, aggregating every instance's entry.
 *
 * invert: does not apply here -- it flips a gpio ACTIVE_LOW/HIGH flag bit,
 * which a pwm ref does not carry (a PWM LED's brightness axis is the duty
 * cycle a consumer drives at runtime, not a placement-time polarity); an
 * instance of this shield setting invert: true is accepted but has no
 * effect on the emitted pwms line.
 *
 * Twister suite (L4-PWM, item 36): tests/rigs/nucleo_grove_farm/, via the
 * persisted boards/rigs/nucleo_grove_farm rig's own pwm_a instance, on a
 * carrier-exposed Grove socket over a REAL arduino-r3 pwm-map (nucleo_f401re
 * and frdm_k64f both now declare one, boards/extend/{st/nucleo_f401re,
 * nxp/frdm_k64f}/arduino_r3_socket.dtsi) -- this shield's own PWM_POLARITY_NORMAL
 * (an unconditionally-zero flags cell) is exactly why grove_pwm_led_inv.shield
 * (this same folder) exists alongside it, to carry a NONZERO flags value the
 * same rig also exercises (l4-pwm-brief.md Sec 6 acceptance criterion 5).
 */

#include <dt-bindings/connector/grove.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	shield-templates {
		grove_pwm_led: grove_pwm_led {
			gpl_plug: plug {
				compatible = "shield,plug";
				shield,plugs = "grove";
			};

			pwm {
				gpl_led: led {
					shield,collect = "pwm-leds";	/* an entry in the shared pwm-leds collection */
					pwms = <&gpl_plug GROVE_SIG0 20000000 PWM_POLARITY_NORMAL>;	/* 20 ms */
				};
			};
		};
	};
};
