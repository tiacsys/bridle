#include "rpipico_r3-connect.dtsi"

#include "ili9341_320x240.dtsi"
#include "ili9341_bgr565.dtsi"
#include "xpt2046_240x320.dtsi"

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

#include <zephyr/dt-bindings/gpio/raspberrypi-pico-header-r3.h>

&rpipico_spi_lcd {
	status = "okay";
	cs-gpios = <&rpipico_header RPIPICO_HEADER_R3_D13 GPIO_ACTIVE_LOW>;	/* GP13 */
};

&mipi_dbi {
	status = "okay";
	reset-gpios = <&rpipico_header RPIPICO_HEADER_R3_D14 GPIO_ACTIVE_LOW>;	/* GP14 */
	dc-gpios = <&rpipico_header RPIPICO_HEADER_R3_D15 GPIO_ACTIVE_HIGH>;	/* GP15 */
	spi-dev = <&rpipico_spi_lcd>;
	#address-cells = <1>;
	#size-cells = <0>;
};

&lcd_panel {
	status = "okay";
};

&rpipico_spi_tsc {
	status = "okay";
	cs-gpios = <&rpipico_header RPIPICO_HEADER_R3_D12 GPIO_ACTIVE_LOW>;	/* GP12 */
};

&tsc_panel {
	status = "okay";
	int-gpios = <&rpipico_header RPIPICO_HEADER_R3_D9 GPIO_ACTIVE_LOW>;	/* GP9 */
};

&rpipico_pwm {
	status = "okay";
	divider-frac-1 = <15>;
	divider-int-1 = <255>;
	divider-frac-2 = <15>;
	divider-int-2 = <255>;
	divider-frac-3 = <15>;
	divider-int-3 = <255>;
};

&pwm_buzzer0 {									/* GP22:PWM3CHA */
	pwms = <&rpipico_pwm 6 PWM_HZ(2700) PWM_POLARITY_NORMAL>;
};

&pwm_led0 {									/* GP2:PWM1A */
	pwms = <&rpipico_pwm 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
};

&pwm_led1 {									/* GP3:PWM1B */
	pwms = <&rpipico_pwm 3 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
};

&pwm_led2 {									/* GP4:PWM2A */
	pwms = <&rpipico_pwm 4 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
};

&pwm_led3 {									/* GP5:PWM2B */
	pwms = <&rpipico_pwm 5 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
};

&led0 {										/* GP2 */
	gpios = <&rpipico_header RPIPICO_HEADER_R3_D2 GPIO_ACTIVE_HIGH>;
};

&led1 {										/* GP3 */
	gpios = <&rpipico_header RPIPICO_HEADER_R3_D3 GPIO_ACTIVE_HIGH>;
};

&led2 {										/* GP4 */
	gpios = <&rpipico_header RPIPICO_HEADER_R3_D4 GPIO_ACTIVE_HIGH>;
};

&led3 {										/* GP5 */
	gpios = <&rpipico_header RPIPICO_HEADER_R3_D5 GPIO_ACTIVE_HIGH>;
};

&btn0 {										/* GP16 */
	gpios = <&rpipico_header RPIPICO_HEADER_R3_D16 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
};

&btn1 {										/* GP17 */
	gpios = <&rpipico_header RPIPICO_HEADER_R3_D17 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
};

&btn2 {										/* GP18 */
	gpios = <&rpipico_header RPIPICO_HEADER_R3_D18 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
};

&btn3 {										/* GP19 */
	gpios = <&rpipico_header RPIPICO_HEADER_R3_D19 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
};
