/dts-v1/;

#include <freq.h>
#include <mem.h>

#include <raspberrypi/rpi_pico/rp2040.dtsi>
#include <raspberrypi/partitions_2M_default.dtsi>

#include <zephyr/dt-bindings/clock/rpi_pico_rp2040_clock.h>
#include <zephyr/dt-bindings/regulator/rpi_pico.h>

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/lvgl/lvgl.h>

#include "arduino_nano_connector.dtsi"
#include "stemma_qt_connector.dtsi"
#include "seeed_grove_connectors.dtsi"
#include "cytron_maker_nano_rp2040-pinctrl.dtsi"

/ {
	model = "Cytron Maker Nano RP2040 @ UART Concole";
	compatible = "cytron,maker-nano-rp2040",
		     "cytron,maker-nano-rp2040-uartcons";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &ssi;
		zephyr,code-partition = &code_partition;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	aliases {
		watchdog0 = &wdt0;
		sw0 = &btn0;
		led0 = &led0;
		pwm-led0 = &pwm_led0;
		pwm-buzzer0 = &pwm_buzzer0;
		led-strip = &led_strip;
	};

	zephyr,user {
		io-channels = <&adc 2>, <&adc 3>;
	};

	lvgl_keypad: lvgl-keypad {
		compatible = "zephyr,lvgl-keypad-input";
		input = <&gpio_keys>;
		input-codes = <INPUT_KEY_0>;
		lvgl-codes = <LV_KEY_ENTER>;
	};

	gpio_keys: gpio_keys {
		compatible = "gpio-keys";

		btn0: btn_0 {
			gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
			label = "BTN1";
		};
	};

	gpio_leds: gpio_leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
			label = "LED";
		};
	};

	pwm_leds: pwm_leds {
		compatible = "pwm-leds";

		pwm_led0: pwm_led_0 {
			pwms = <&pwm 9 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "PWM_LED";
		};
	};

	pwm_buzzers {
		compatible = "pwm-buzzers";

		pwm_buzzer0: pwm_buzzer0 {
			pwms = <&pwm 6 PWM_HZ(880) PWM_POLARITY_NORMAL>;
			label = "PWM_BUZZER";
		};
	};
};

&flash0 {
	status = "okay";
	reg = <0x10000000 DT_SIZE_M(2)>;
	ranges = <0x0 0x10000000 DT_SIZE_M(2)>;
};

&clocks {
	status = "okay";
	pinctrl-0 = <&clocks_default>;
	pinctrl-names = "default";
};

&vreg {
	status = "okay";
	regulator-always-on;
	regulator-allowed-modes = <REGULATOR_RPI_PICO_MODE_NORMAL>;
};

&reset {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&rtc {
	status = "okay";
	clocks = <&clocks RPI_PICO_CLKID_CLK_RTC>;
};

&timer {
	status = "okay";
};

&dma {
	status = "okay";
};

&die_temp {
	status = "okay";
	friendly-name = "RP2040 chip temperature";
};

&uart0 {
	status = "okay";
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

zephyr_udc0: &usbd {
	status = "okay";
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";
	clock-frequency = <DT_FREQ_M(8)>;
};

&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_ws2812_default>;
	pinctrl-names = "default";

	clock-frequency = <DT_FREQ_M(1)>;

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		status = "okay";

		reg = <0>;
		spi-max-frequency = <DT_FREQ_K(6400)>;	/* Tbit = 156.25 ns */

		/* HI: 0xFC: 11111100: 0.937 us high and 0.313 us low */
		/* LO: 0xC0: 11000000: 0.313 us high and 0.937 us low */
		spi-one-frame = <0xfc>;
		spi-zero-frame = <0xc0>;

		chain-length = <2>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
	};
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&pwm {
	status = "okay";
	pinctrl-0 = <&pwm_default>;
	pinctrl-names = "default";
	divider-int-3 = <255>;	/* buzzer: PWM3CHA (6) */
	divider-int-4 = <255>;	/* led:    PWM4CHB (9) */
	divider-frac-4 = <15>;
};

&adc {
	status = "okay";
	pinctrl-0 = <&adc_default>;
	pinctrl-names = "default";
};

&gpio0 {
	status = "okay";
	/* namespace and positions without wired bits */
	gpio-reserved-ranges = <10 1>, <21 1>, <23 3>;
	gpio-line-names =
		"AH1Q02_TX0",		/* GP0 */
		"AH2Q01_RX0",		/* GP1 */
		"AH5",			/* GP2 */
		"AH6",			/* GP3 */
		"AH7",			/* GP4 */
		"AH8",			/* GP5 */
		"AH9",			/* GP6 */
		"AH10",			/* GP7 */
		"AH11",			/* GP8 */
		"AH12_ULED0",		/* GP9 */
		"",	 /* not connected, GP10 */
		"RGB_SDO1",		/* GP11 */
		"AH23_SDA0",		/* GP12 */
		"AH24_SCL0",		/* GP13 */
		"AH25",			/* GP14 */
		"AH26",			/* GP15 */
		"AH15_SDI0",		/* GP16 */
		"AH13_CSN0",		/* GP17 */
		"AH16_SCK0",		/* GP18 */
		"AH14_SDO0",		/* GP19 */
		"UBTN0",		/* GP20 */
		"",	 /* not connected, GP21 */
		"BUZZER_PWM6",		/* GP22 */
		"",	 /* not connected, GP23 */
		"",	 /* not connected, GP24 */
		"",	 /* not connected, GP25 */
		"AH19Q12_SDA1",		/* GP26 */
		"AH20Q11_SCL1",		/* GP27 */
		"AH21_ADC2",		/* GP28 */
		"AH22_ADC3";		/* GP29 */
};
