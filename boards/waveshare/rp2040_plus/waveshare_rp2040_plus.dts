/dts-v1/;

#include <freq.h>
#include <mem.h>

#include <raspberrypi/rpi_pico/rp2040.dtsi>

#include <zephyr/dt-bindings/clock/rpi_pico_rp2040_clock.h>
#include <zephyr/dt-bindings/regulator/rpi_pico.h>

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

#include "raspberrypi_pico_connector.dtsi"
#include "raspberrypi_pico_r3_connector.dtsi"
#include "waveshare_rp2040_plus-pinctrl.dtsi"

/ {
	model = "Waveshare RP2040-Plus @ UART Concole";
	compatible = "waveshare,rp2040-plus", "waveshare,rp2040-plus-uartcons";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &ssi;
		zephyr,code-partition = &code_partition;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	aliases {
		watchdog0 = &wdt0;
		led0 = &led0;
		pwm-led0 = &pwm_led0;
	};

	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>;
	};

	gpio_leds: gpio_leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
			label = "LED";
		};
	};

	pwm_leds: pwm_leds {
		compatible = "pwm-leds";

		pwm_led0: pwm_led_0 {
			pwms = <&pwm 9 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "PWM_LED";
		};
	};
};

&flash0 {
	status = "okay";
};

&clocks {
	status = "okay";
	pinctrl-0 = <&clocks_default>;
	pinctrl-names = "default";
};

&vreg {
	status = "okay";
	regulator-always-on;
	regulator-allowed-modes = <REGULATOR_RPI_PICO_MODE_NORMAL>;
};

&reset {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&rtc {
	status = "okay";
	clocks = <&clocks RPI_PICO_CLKID_CLK_RTC>;
};

&timer {
	status = "okay";
};

&dma {
	status = "okay";
};

&die_temp {
	status = "okay";
	friendly-name = "RP2040 chip temperature";
};

&uart0 {
	status = "okay";
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

zephyr_udc0: &usbd {
	status = "okay";
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_pico_default>;
	pinctrl-names = "default";
	clock-frequency = <DT_FREQ_M(8)>;
};

&spi1 {
	status = "disabled";
	pinctrl-0 = <&spi1_pico>;
	pinctrl-names = "default";
	clock-frequency = <DT_FREQ_M(8)>;
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_pico_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&i2c1 {
	status = "disabled";
	pinctrl-0 = <&i2c1_pico_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&pwm {
	status = "okay";
	pinctrl-0 = <&pwm_pico_default>;
	pinctrl-names = "default";
	divider-int-4 = <255>;	/* led: PWM4CHB (9) */
};

&adc {
	status = "okay";
	pinctrl-0 = <&adc_default>;
	pinctrl-names = "default";
};

&gpio0 {
	status = "okay";
	/* namespace and positions without wired bits */
	gpio-line-names =
		"TX0",			/* GP0 */
		"TX1",			/* GP1 */
		"GP2_PWM2_CTS0",	/* GP2 */
		"GP3_PWM3_RTS0",	/* GP3 */
		"SDA0",			/* GP4 */
		"SCL0",			/* GP5 */
		"GP6_PWM6",		/* GP6 */
		"GP7_PWM7",		/* GP7 */
		"GP8_PWM8",		/* GP8 */
		"GP9_PWM9_CSN1",	/* GP9 */
		"GP10_PWM10_SCK1",	/* GP10 */
		"GP11_PWM11_SDO1",	/* GP11 */
		"GP12_PWM12_SDI1",	/* GP12 */
		"GP13_PWM13",		/* GP13 */
		"GP14_PWM14_SDA1",	/* GP14 */
		"GP15_PWM15_SCL1",	/* GP15 */
		"SDI0",			/* GP16 */
		"CSN0",			/* GP17 */
		"SCK0",			/* GP18 */
		"SDO0",			/* GP19 */
		"GP20_PWM4",		/* GP20 */
		"GP21_PWM5",		/* GP21 */
		"GP22_PWM6",		/* GP22 */
		"PSU_SMPS_PWM7",	/* GP23 */
		"PSU_VBUS/1.51",	/* GP24 */
		"ULED0_PWM9",		/* GP25 */
		"ADC0",			/* GP26 */
		"ADC1",			/* GP27 */
		"ADC2",			/* GP28 */
		"PSU_ADC3_VSYS/3";	/* GP29 */
};
