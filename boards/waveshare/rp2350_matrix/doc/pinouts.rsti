          :hwftlbl-adc:`4`
          :hwftlbl-i2c:`1`
          :hwftlbl-spi:`1`
          :hwftlbl-uart:`1`

       :on-pads(A-H):
          :hwftlbl-pio:`6`
          :hwftlbl-pwm:`2`
          :hwftlbl-uart:`1`

       :on-board:
