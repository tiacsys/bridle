#include <mem.h>
#include <freq.h>

#include <raspberrypi/partitions_0x0_default_16M.dtsi>

#include <zephyr/dt-bindings/clock/rpi_pico_rp2350_clock.h>
#include <zephyr/dt-bindings/regulator/rpi_pico.h>

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/led/led.h>

#include <zephyr/dt-bindings/display/panel.h>

#include "waveshare_rp2350matrix_pads.dtsi"
#include "waveshare_rp2350matrix_connector.dtsi"
#include "waveshare_rp2350_matrix-pinctrl.dtsi"

/ {
	model = "Waveshare RP2350-Matrix @ UART Concole";
	compatible = "waveshare,rp2350-matrix",
		     "waveshare,rp2350-matrix-uartcons";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &qmi;
		zephyr,code-partition = &code_partition;
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
		zephyr,display = &led_strip_matrix;
	};

	aliases {
		6dof-motion-drdy0 = &qmi8658;
		accel0 = &qmi8658;
		led-strip = &led_strip;
		watchdog0 = &wdt0;
	};

	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>;
	};

	led_strip_matrix: led-strip-matrix {
		compatible = "led-strip-matrix";
	};
};

&flash0 {
	status = "okay";
	reg = <0x10000000 DT_SIZE_M(16)>;
	ranges = <0x0 0x10000000 DT_SIZE_M(16)>;

	partitions {
		storage_partition: partition@100000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x100000 DT_SIZE_M(15)>;
		};
	};
};

&code_partition {
	reg = <0x0 DT_SIZE_M(1)>;
};

&clocks {
	status = "okay";
	pinctrl-0 = <&clocks_default>;
	pinctrl-names = "default";
};

&vreg {
	status = "okay";
	regulator-always-on;
	regulator-allowed-modes = <REGULATOR_RPI_PICO_MODE_NORMAL>;
};

&reset {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&timer0 {
	status = "okay";
};

&timer1 {
	status = "okay";
};

&dma {
	status = "okay";
};

&die_temp {
	status = "okay";
	friendly-name = "RP2350 chip temperature";
};

zephyr_udc0: &usbd {
	status = "okay";
};

&uart0 {
	status = "okay";
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

&uart1 {
	status = "okay";
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";
	clock-frequency = <DT_FREQ_M(8)>;
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;

	/* Accelerometer and Gyroscope with QMI8658A sensor. */
	qmi8658: qmi8658a@6b {
		compatible = "qst,qmi8658a";
		friendly-name = "on-board accelerometer/gyroscope";
		status = "okay";

		reg = <0x6b>;

		/* GP9 as INT2 from QMI8658A sensor. */
		int-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		int-pin = <2>;

		accel-fs = <2>;
		gyro-fs = <512>;
		accel-odr = <224>;
		gyro-odr = <224>;
	};
};

&pio0 {
	status = "okay";

	pio-ws2812 {
		compatible = "worldsemi,ws2812-rpi_pico-pio";
		status = "okay";

		pinctrl-0 = <&pio0_ws2812_default>;
		pinctrl-names = "default";

		/* HI: 0x3F0: 1111110000: 0.750 us high and 0.500 us low */
		/* LO: 0x380: 1110000000: 0.375 us high and 0.875 us low */
		bit-waveform = <3>, <3>, <4>;

		ws2812_8x8: ws2812-8x8 {
			status = "okay";

			chain-length = <(8*8)>; /* 8x8 panel with RGB pixel */
			color-mapping = <LED_COLOR_ID_RED
					 LED_COLOR_ID_GREEN
					 LED_COLOR_ID_BLUE>;

			/* PIO0:OUT @ GP16 and Tbit = 1.25 us / 10 */
			gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
			frequency = <DT_FREQ_K(800)>;
			reset-delay = <280>;
		};
	};
};

led_strip: &ws2812_8x8 {};

&led_strip_matrix {
	/* LED strip with circulative layout */
	led-strips = <&led_strip>;
	circulative;

	/* 8x8 panel with RGB pixel and alpha channel */
	width = <8>;
	height = <8>;
	pixel-format = <PANEL_PIXEL_FORMAT_ARGB_8888>;
};

&pwm {
	status = "okay";
	pinctrl-0 = <&pwm_default>;
	pinctrl-names = "default";
};

&adc {
	status = "okay";
	pinctrl-0 = <&adc_default>;
	pinctrl-names = "default";
};

gpio0_lo: &gpio0 {
	status = "okay";
	/* namespace and positions without wired bits */
	gpio-reserved-ranges = <25 1>;
	gpio-line-names =
		"TX0",			/* GP0 */
		"RX0",			/* GP1 */
		"GP2_CTS0",		/* GP2 */
		"GP3_RTS0",		/* GP3 */
		"GP4_DSR0",		/* GP4 */
		"GP5_DTR0",		/* GP5 */
		"IMU_SDA1",		/* GP6 */
		"IMU_SCL1",		/* GP7 */
		"IMU_INT1",		/* GP8 */
		"IMU_INT2",		/* GP9 */
		"TX1",			/* GP10 */
		"RX1",			/* GP11 */
		"SDA0",			/* GP12 */
		"SCL0",			/* GP13 */
		"GP14",			/* GP14 */
		"GP15",			/* GP15 */
		"SDI0",			/* GP16 */
		"CSN0",			/* GP17 */
		"SCK0",			/* GP18 */
		"SDO0",			/* GP19 */
		"GP20_PWM4_DCD0",	/* GP20 */
		"GP21_PWM5_RI0",	/* GP21 */
		"GP22_PWM6",		/* GP22 */
		"GP23_PWM7",		/* GP23 */
		"GP24_PWM8",		/* GP24 */
		"",  /* Din of LED stripe, GP25 */
		"ADC0",			/* GP26 */
		"ADC1",			/* GP27 */
		"ADC2",			/* GP28 */
		"ADC3";			/* GP29 */
};
