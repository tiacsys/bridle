/dts-v1/;

#include <freq.h>
#include <mem.h>

#include <raspberrypi/rpi_pico/rp2040.dtsi>
#include <raspberrypi/partitions_2M_default.dtsi>

#include <zephyr/dt-bindings/clock/rpi_pico_rp2040_clock.h>
#include <zephyr/dt-bindings/regulator/rpi_pico.h>

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

#include "stemma_qt_connector.dtsi"
#include "raspberrypi_dbg_connectors.dtsi"
#include "waveshare_rp2040_geek-pinctrl.dtsi"

/ {
	model = "Waveshare RP2040-Geek @ UART Concole";
	compatible = "waveshare,rp2040-geek",
		     "waveshare,rp2040-geek-uartcons";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &ssi;
		zephyr,code-partition = &code_partition;
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
		zephyr,display = &lcd_panel;
	};

	aliases {
		watchdog0 = &wdt0;
		led0 = &led0;
		pwm-led0 = &pwm_led0;
	};

	zephyr,user {
		io-channels = <&adc 2>, <&adc 3>;
	};

	gpio_leds: gpio-leds {
		compatible = "gpio-leds";

		led0: led0 {
			gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
			label = "LCD_BL";
		};
	};

	pwm_leds: pwm-leds {
		compatible = "pwm-leds";

		pwm_led0: pwm-led0 {
			pwms = <&pwm 9 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "PWM_LCD_BL";
		};
	};

	mipi_dbi_spi1: mipi-dbi-spi1 {
		compatible = "zephyr,mipi-dbi-spi";
		#address-cells = <1>;
		#size-cells = <0>;
	};

	lcd_backlight_en: lcd-backlight-en {
		compatible = "regulator-gpio";
		regulator-name = "lcd_backlight";
	};
};

&flash0 {
	status = "okay";
	reg = <0x10000000 DT_SIZE_M(4)>;
	ranges = <0x0 0x10000000 DT_SIZE_M(4)>;
};

&storage_partition {
	reg = <0x100000 DT_SIZE_M(3)>;
};

&clocks {
	status = "okay";
	pinctrl-0 = <&clocks_default>;
	pinctrl-names = "default";
};

&vreg {
	status = "okay";
	regulator-always-on;
	regulator-allowed-modes = <REGULATOR_RPI_PICO_MODE_NORMAL>;
};

&reset {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&rtc {
	status = "okay";
	clocks = <&clocks RPI_PICO_CLKID_CLK_RTC>;
};

&timer {
	status = "okay";
};

&dma {
	status = "okay";
};

&die_temp {
	status = "okay";
	friendly-name = "RP2040 chip temperature";
};

&uart1 {
	status = "okay";
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

zephyr_udc0: &usbd {
	status = "okay";
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_sdhc>;
	pinctrl-names = "default";
	clock-frequency = <DT_FREQ_M(25)>;

	/* GP23 as CSn to MMC/SD-Card slot. */
	cs-gpios = <&gpio0 23 GPIO_ACTIVE_LOW>;

	/* SPI as Secure Digital card Host Controller (SDHC). */
	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		status = "okay";

		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(25)>;

		/* Secure Digital card as Multi-Media Card (SDMMC) */
		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_lcd>;
	pinctrl-names = "default";
	clock-frequency = <DT_FREQ_M(20)>;

	/* GP9 as CSn to ST7789V LCD panel controller. */
	cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
};

&mipi_dbi_spi1 {
	status = "okay";

	/* SPI1 as serial bus to ST7789V LCD panel controller. */
	spi-dev = <&spi1>;
	write-only;

	/* GP8/12 as DC/RST to ST7789V LCD panel controller. */
	reset-gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
	dc-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;

	/* LCD with ST7789V controller. */
	st7789v_240x135: st7789v-240x135@0 {
		compatible = "sitronix,st7789v";
		status = "okay";

		reg = <0>;
		mipi-max-frequency = <DT_FREQ_M(20)>;
		mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";

		/* 16-bit, RGB565 */
		pixel-format = <PANEL_PIXEL_FORMAT_RGB_565X>;
	//	inversion-on; /* required for CMYK */

		/* landscape */
		width = <240>;
		height = <135>;
		x-offset = <40>;
		y-offset = <53>;
		mdac = <0x60>;
	//	mdac = <0xE0>; /* mirrored */
	//	mdac = <0xA0>; /* overhead */
	//	mdac = <0x20>; /* upsidedown */

		/* portrait */
	//	width = <135>;
	//	height = <240>;
	//	x-offset = <52>;
	//	y-offset = <40>;
	//	mdac = <0x00>;
	//	mdac = <0x40>; /* mirrored */
	//	mdac = <0xC0>; /* overhead */
	//	mdac = <0x80>; /* upsidedown */

		vcom = <0x1f>;
		gctrl = <0x35>;
		vrhs = <0x12>;
		vdvs = <0x20>;
		gamma = <0x01>;
		lcm = <0x2C>;
		porch-param = [0C 0C 00 33 33];
		cmd2en-param = [5A 69 02 01];
		pwctrl1-param = [A4 A1];
		pvgam-param = [D0 08 11 08 0C 15 39 33 50 36 13 14 29 2D];
		nvgam-param = [D0 08 10 08 06 06 39 44 51 0B 16 14 2F 31];
		ram-param = [00 F0];
		rgb-param = [CD 08 14];
	};
};

lcd_panel: &st7789v_240x135 {};

&lcd_backlight_en {
	status = "okay";
	regulator-always-on;
	regulator-min-microvolt = <0>;
	regulator-max-microvolt = <3300000>;
	regulator-init-microvolt = <3300000>;

	/* GP25 as backlight switch to LCD panel. */
	gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
	states = <3300000 1>, <0 0>;
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_geek_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&i2c1 {
	status = "disabled";
	pinctrl-0 = <&i2c1_geek_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

rpigeek_pwm: &pwm {
	status = "okay";
	pinctrl-0 = <&pwm_geek_default>;
	pinctrl-names = "default";
	divider-int-4 = <255>;  /* led: PWM4CHB (9) */
};

rpigeek_adc: &adc {
	status = "okay";
	pinctrl-0 = <&adc_default>;
	pinctrl-names = "default";
};

&gpio0 {
	status = "okay";
	/* namespace and positions without wired bits */
	gpio-reserved-ranges = <0 2>,  <6 2>,  <13 5>,
			       <21 2>, <24 1>, <26 2>;
	gpio-line-names =
		"",			/* GP0 */
		"",			/* GP1 */
		"GP2_SDA0",		/* GP2 */
		"GP3_SCL0",		/* GP3 */
		"TX1",			/* GP4 */
		"RX1",			/* GP5 */
		"",			/* GP6 */
		"",			/* GP7 */
		"LCD_DC",		/* GP8 */
		"LCD_CSN1",		/* GP9 */
		"LCD_SCK1",		/* GP10 */
		"LCD_SDO1",		/* GP11 */
		"LCD_RST",		/* GP12 */
		"",			/* GP13 */
		"",			/* GP14 */
		"",			/* GP15 */
		"",			/* GP16 */
		"",			/* GP17 */
		"SDHC_SCK0",		/* GP18 */
		"SDHC_SDO0",		/* GP19 */
		"SDHC_SDI0",		/* GP20 */
		"",			/* GP21 */
		"",			/* GP22 */
		"SDHC_CSN0",		/* GP23 */
		"",			/* GP24 */
		"LCD_BL_PWM9",		/* GP25 */
		"",			/* GP26 */
		"",			/* GP27 */
		"SDA0_ADC2",		/* GP28 */
		"SCL0_ADC3";		/* GP29 */
};
