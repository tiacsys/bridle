#include <mem.h>
#include <freq.h>

#include <raspberrypi/partitions_0x0_default_4M.dtsi>

#include <zephyr/dt-bindings/clock/rpi_pico_rp2350_clock.h>
#include <zephyr/dt-bindings/regulator/rpi_pico.h>

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

#include "raspberrypi_pico_connector.dtsi"
#include "raspberrypi_pico_r3_connector.dtsi"
#include "waveshare_rp2350_can-pinctrl.dtsi"

/ {
	model = "Waveshare RP2350-CAN @ UART Concole";
	compatible = "waveshare,rp2350-can",
		     "waveshare,rp2040-can-uartcons";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &qmi;
		zephyr,code-partition = &code_partition;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,canbus = &can0;
	};

	aliases {
		watchdog0 = &wdt0;
		led0 = &led0;
		pwm-led0 = &pwm_led0;
	};

	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>;
	};

	gpio_leds: gpio-leds {
		compatible = "gpio-leds";

		led0: led0 {
			gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
			label = "LED";
		};
	};

	pwm_leds: pwm-leds {
		compatible = "pwm-leds";

		pwm_led0: pwm_led0 {
			pwms = <&pwm 9 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "PWM_LED";
		};
	};
};

&flash0 {
	status = "okay";
	reg = <0x10000000 DT_SIZE_M(4)>;
	ranges = <0x0 0x10000000 DT_SIZE_M(4)>;

	partitions {
		storage_partition: partition@100000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x100000 DT_SIZE_M(3)>;
		};
	};
};

&code_partition {
	reg = <0x0 DT_SIZE_M(1)>;
};

&clocks {
	status = "okay";
	pinctrl-0 = <&clocks_default>;
	pinctrl-names = "default";
};

&vreg {
	status = "okay";
	regulator-always-on;
	regulator-allowed-modes = <REGULATOR_RPI_PICO_MODE_NORMAL>;
};

&reset {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&timer0 {
	status = "okay";
};

&timer1 {
	status = "okay";
};

&dma {
	status = "okay";
};

&die_temp {
	status = "okay";
	friendly-name = "RP2350 chip temperature";
};

zephyr_udc0: &usbd {
	status = "okay";
};

&uart0 {
	status = "okay";
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_pico_default>;
	pinctrl-names = "default";
	clock-frequency = <DT_FREQ_M(8)>;
};

&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_can>;
	pinctrl-names = "default";

	clock-frequency = <DT_FREQ_M(10)>;
	cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

	/* Xinluda XL2515QF20 is compatible to MicroChip MCP2515 */
	xl2515: xl2515@0 {
		compatible = "microchip,mcp2515";
		status = "okay";

		reg = <0x0>;
		spi-max-frequency = <DT_FREQ_M(10)>;
		int-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
		osc-freq = <DT_FREQ_M(16)>;

		can-transceiver {
			max-bitrate = <DT_FREQ_M(1)>;
		};
	};
};

can0: &xl2515 {};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_pico_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&i2c1 {
	status = "disabled";
	pinctrl-0 = <&i2c1_pico_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&pwm {
	status = "okay";
	pinctrl-0 = <&pwm_pico_default>;
	pinctrl-names = "default";
	divider-int-4 = <255>;	/* led: PWM4CHB (9) */
};

&adc {
	status = "okay";
	pinctrl-0 = <&adc_default>;
	pinctrl-names = "default";
};

gpio0_lo: &gpio0 {
	status = "okay";
	/* namespace and positions without wired bits */
	gpio-line-names =
		"TX0",			/* GP0 */
		"RX0",			/* GP1 */
		"GP2_CTS0",		/* GP2 */
		"GP3_RTS0",		/* GP3 */
		"SDA0",			/* GP4 */
		"SCL0",			/* GP5 */
		"GP6",			/* GP6 */
		"GP7",			/* GP7 */
		"CAN_IRQ",		/* GP8 */
		"CAN_CSN1",		/* GP9 */
		"CAN_SCK1",		/* GP10 */
		"CAN_SDO1",		/* GP11 */
		"CAN_SDI1",		/* GP12 */
		"GP13",			/* GP13 */
		"GP14_SDA1",		/* GP14 */
		"GP15_SCL1",		/* GP15 */
		"SDI0",			/* GP16 */
		"CSN0",			/* GP17 */
		"SCK0",			/* GP18 */
		"SDO0",			/* GP19 */
		"GP20_PWM4",		/* GP20 */
		"GP21_PWM5",		/* GP21 */
		"GP22_PWM6",		/* GP22 */
		"PSU_SMPS",		/* GP23 */
		"PSU_VBUS/1.51",	/* GP24 */
		"ULED0_PWM9",		/* GP25 */
		"ADC0",			/* GP26 */
		"ADC1",			/* GP27 */
		"ADC2",			/* GP28 */
		"PSU_ADC3_VSYS/2";	/* GP29 */
};
