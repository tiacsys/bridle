          :hwftlbl-pio:`3`
          :hwftlbl-pwm:`3`
          :hwftlbl-adc:`4`
          :hwftlbl-i2c:`1`
          :hwftlbl-spi:`1`
          :hwftlbl-uart:`1`

       :on-qwiic(QC,QD):
          :hwftlbl-pio:`(2)`
          :hwftlbl-i2c:`1`
          :hwftlbl-uart:`(1)`

       :on-pads(A-M):
          :hwftlbl-pio:`12`
          :hwftlbl-pwm:`11`

       :on-board:
