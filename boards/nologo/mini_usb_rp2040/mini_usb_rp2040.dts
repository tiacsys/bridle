/dts-v1/;

#include <freq.h>

#include <raspberrypi/rpi_pico/rp2040.dtsi>

#include <zephyr/dt-bindings/clock/rpi_pico_rp2040_clock.h>
#include <zephyr/dt-bindings/regulator/rpi_pico.h>

#include <zephyr/dt-bindings/i2c/i2c.h>

#include "mini_usb_rp2040-pinctrl.dtsi"

#include "stemma_qt_connector.dtsi"
#include "seeed_grove_connectors.dtsi"
#include "nologo_miniusb_connector.dtsi"
#include "nologo_miniusb_pads.dtsi"

/ {
	model = "Nologo Mini USB RP2040 @ USB-CDC/ACM Concole";
	compatible = "nologo,mini-usb-rp2040",
		     "nologo,mini-usb-rp2040-usbcons";

	chosen {
		zephyr,sram = &sram0;
		zephyr,console = &cdc_acm_console_uart;
		zephyr,shell-uart = &cdc_acm_console_uart;
	};

	aliases {
		watchdog0 = &wdt0;
		rtc = &rtc;
	};

	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>;
	};
};

&clocks {
	status = "okay";
	pinctrl-0 = <&clocks_default>;
	pinctrl-names = "default";
};

&vreg {
	status = "okay";
	regulator-always-on;
	regulator-allowed-modes = <REGULATOR_RPI_PICO_MODE_NORMAL>;
};

&reset {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&rtc {
	status = "okay";
	clocks = <&clocks RPI_PICO_CLKID_CLK_RTC>;
};

&timer {
	status = "okay";
};

&dma {
	status = "okay";
};

&die_temp {
	status = "okay";
	friendly-name = "RP2040 chip temperature";
};

zephyr_udc0: &usbd {
	status = "okay";
	cdc_acm_console_uart: cdc-acm-console-uart {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&uart0 {
	status = "okay";
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
	current-speed = <115200>;
	data-bits = <8>;
	parity = "none";
	stop-bits = "1";
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&i2c1 {
	status = "disabled";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";
	clock-frequency = <DT_FREQ_M(8)>;
};

&adc {
	status = "okay";
	pinctrl-0 = <&adc_default>;
	pinctrl-names = "default";
};

&pwm {
	status = "disabled";
	pinctrl-0 = <&pwm_default>;
	pinctrl-names = "default";
};

&gpio0 {
	status = "okay";
	/* namespace and positions without wired bits */
	gpio-reserved-ranges = <22 1>;
	gpio-line-names =
		"TX0",			/* GP0 */
		"RX0",			/* GP1 */
		"GP2_CTS0",		/* GP2 */
		"GP3_RTS0",		/* GP3 */
		"SDI0",			/* GP4 */
		"CSN0",			/* GP5 */
		"SCK0",			/* GP6 */
		"SDO0",			/* GP7 */
		"GP8_PWM8",		/* GP8 */
		"GP9_PWM9",		/* GP9 */
		"GP10_PWM10",		/* GP10 */
		"GP11_PWM11",		/* GP11 */
		"GP12_PWM12",		/* GP12 */
		"GP13_PWM13",		/* GP13 */
		"GP14_SDA1",		/* GP14 */
		"GP15_SCL1",		/* GP15 */
		"SDA0",			/* GP16 */
		"SCL0",			/* GP17 */
		"GP18_PWM2",		/* GP18 */
		"GP19_PWM3",		/* GP19 */
		"GP20_PWM4",		/* GP20 */
		"GP21_PWM5",		/* GP21 */
		"",  /* Din of LED stripe, GP22 */
		"GP23_PWM7",		/* GP23 */
		"GP24_PWM8",		/* GP24 */
		"GP25_PWM9",		/* GP25 */
		"ADC0",			/* GP26 */
		"ADC1",			/* GP27 */
		"ADC2",			/* GP28 */
		"ADC3";			/* GP29 */
};
